{
  "name": "asrpro",
  "private": true,
  "version": "0.1.0",
  "productName": "ASR Pro",
  "description": "Cross-platform desktop speech recognition and transcription workspace.",
  "author": "Suraj Mandal <surajmandalcell@gmail.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4270",
    "start": "electron .",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4271",
    "sidecar:dev": "if [ -x sidecar/.venv/bin/python ]; then sidecar/.venv/bin/python sidecar/main.py; else python3 sidecar/main.py; fi",
    "electron:dev": "concurrently -k \"npm:sidecar:dev\" \"npm:dev\" \"wait-on http://127.0.0.1:4270 http://127.0.0.1:8000/health && electron .\"",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.60.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.6",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.surajmandal.asrpro",
    "productName": "ASR Pro",
    "artifactName": "ASR-Pro-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "src-tauri/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "win": {
      "icon": "src-tauri/icons/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "src-tauri/icons/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  }
}
